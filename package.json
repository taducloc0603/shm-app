{
  "name": "shm-desktop-ui",
  "version": "1.0.0",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "rebuild-native": "node-gyp rebuild --directory native/shm_reader",
    "test": "node --test test/gapTickLine.test.mjs test/gapTickRecord.test.mjs test/gapTickStream.test.mjs test/quoteSeq.test.mjs test/tickLogger.test.js test/tickLoggerBinary.test.mjs",
    "ticks": "node tools/ticks.mjs"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "node-addon-api": "^8.3.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "node-gyp": "^11.1.0"
  },
  "build": {
    "appId": "com.taducloc.shmhub",
    "productName": "ShmHub",
    "asarUnpack": [
      "native/shm_reader/build/**/*.node"
    ],
    "files": [
      "src/**/*",
      "index.html",
      "main.js",
      "preload.js",
      "native/shm_reader/build/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "tools", "to": "decoder/tools" },
      { "from": "packaging/win", "to": "decoder" },
      { "from": "src/renderer/utils", "to": "decoder/src/renderer/utils" },
      { "from": "src/main/gapTickFile.js", "to": "decoder/src/main/gapTickFile.js" }
    ],
    "win": { "target": "nsis" }
  }
}
